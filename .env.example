# ===== ValueClue S1 环境变量模板(复制为你的环境文件后填值,勿提交真值) =====
# SEC EDGAR 要求 User-Agent 携带真实联系邮箱
SEC_CONTACT_EMAIL=you@example.com
# LLM 网关(OpenAI 兼容,/v1 结尾)
SUB2_BASE_URL=https://your-llm-gateway.example/v1
SUB2_CLAUDE_KEY=
SUB2_CLAUDE_MODEL=claude-sonnet-4-6
# Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 主机与路径
PIPELINE_HOME=/opt/valueclue/pipeline
JUDGMENTS_HOME=/opt/valueclue/judgments
NAS_USER=nas
NAS_HOST=your-nas-host
SERVER_USER=ubuntu
SERVER_PUBLIC_IP=your-server-ip
